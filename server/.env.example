PORT=4000
# Leave empty to use embedded PGlite (Postgres in WASM, ./data). docker-compose uses a real Postgres.
DATABASE_URL=
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# Admin account created on first start. If ADMIN_PASSWORD is empty a random one is generated and printed once.
ADMIN_EMAIL=admin@shopsense.local
ADMIN_PASSWORD=
# OpenAI-compatible LLM (OpenAI, Groq, Together, Ollama at http://localhost:11434/v1). Optional: rule-based fallbacks are used without it.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
CORS_ORIGIN=http://localhost:5173
